<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appSettings>
    <add key="PYTHONPATH" value="C:\inetpub\wwwroot\land_registry" />
    <add key="WSGI_HANDLER" value="land_registry.wsgi.application" />
    <add key="DJANGO_SETTINGS_MODULE" value="land_registry.settings" />
  </appSettings> 
    <system.webServer>
        <handlers>
            <add name="land_registry" path="*" verb="*" modules="FastCgiModule" scriptProcessor="C:\Python\Python311-32\python.exe|C:\Python\Python311-32\Lib\site-packages\wfastcgi.py" resourceType="Unspecified" />
        </handlers>
    </system.webServer>
</configuration>
